  "role": "Beginning front-end web developer",
  "roleDefinition": "A learner who can independently produce and explain small semantic, responsive, accessible static sites using HTML, CSS, browser JavaScript, local JSON, browser storage, DevTools, Git, and GitHub Pages.",
  "evidenceSummary": "The capability boundary was triangulated across current web-platform, accessibility, browser-tooling, and Git/GitHub teaching, then constrained to eight six-hour instructional Weeks.",
  "capabilityTiers": [
    {
      "tier": "Structure and style",
      "weeks": "1-3",
      "outcome": "Create valid semantic pages, use the cascade and box model deliberately, and build responsive Flexbox/Grid layouts with measured contrast and reflow."
    },
    {
      "tier": "Behavior and data",
      "weeks": "4-7",
      "outcome": "Implement DOM events, canonical collection state, local persistence, accessible forms, deterministic fetch states, and evidence-led browser debugging."
    },
    {
      "tier": "Integrated delivery",
      "weeks": "8",
      "outcome": "Integrate proven behaviors into a documented, manually verified static application and publish it safely through GitHub Pages."
    }
  ],
  "practitionerOutputs": [
    "Semantic Semester Guide",
    "Study Space Card Gallery",
    "Campus Events Board",
    "Campus Notice Switcher",
    "Weekly Study Checklist",
    "Accessible Workshop Seat Request",
    "Campus Services Viewer",
    "FreshStart Hub - Orientation Event Finder"
  ],
  "professionalPractices": [
    "start with semantic source order",
    "use reusable CSS and inspect the cascade",
    "design mobile first and verify reflow",
    "update canonical state before rendering",
    "prefer native controls and safe text insertion",
    "test keyboard and focus behavior manually",
    "show honest loading, empty, and failure states",
    "reproduce failures before editing",
    "inspect staged files before publishing",
    "verify the real deployed route and assets"
  ],
  "boundaries": [
    "No framework or package manager",
    "No backend, database, or authentication",
    "No external API or API key",
    "No user-generated remote data",
    "No service worker",
    "No automated deployment pipeline",
    "No claim of universal accessibility, production security, or cross-browser perfection"
  ],
  "graduationBoundary": "Create, debug, verify, document, version, and publish small semantic, responsive, accessible, interactive static websites with HTML, CSS, and browser JavaScript, with enough fluency for introductory practical examinations and beginner projects.",
  "technologyDecision": "Plain HTML, CSS, browser JavaScript, VS Code, an HTTP localhost preview, browser DevTools, Git, and GitHub Pages provide the least strenuous free Windows route with high practical-exam and project value.",
